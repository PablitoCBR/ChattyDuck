<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Basics -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.5" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Core" Version="1.2.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- IdentityServer -->
    <!-- TODO: Plan the upgrade to Duende IdentityServer v8 (HybridCache, TimeProvider, new EF migrations) before
         building much more on v7. -->
    <PackageVersion Include="Duende.IdentityServer.EntityFramework" Version="7.4.3" />
    <PackageVersion Include="Duende.IdentityServer.AspNetIdentity" version="7.4.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
    <!-- TODO: Bump EF Core Tools. 10.0.1 pulls in System.Security.Cryptography.Pkcs 9.0.0 (known moderate and high
         vulnerabilities) through EntityFrameworkCore.Design. Design-time only (PrivateAssets=all), not shipped. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1" />
    <!-- TODO: Migrate to PostgreSQL -->
    <!-- Aspire (AppHost only, ADR 0004) -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />

    <!-- BUILD TOOLS -->
     <PackageVersion Include="Meziantou.Analyzer" Version="3.0.325"/>
     <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138"/>
     <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1"/>
     <PackageVersion Include="xunit.analyzers" Version="2.2.0"/>
  </ItemGroup>
</Project>