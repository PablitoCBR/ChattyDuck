---
config:
  layout: elk
---
graph TB
    subgraph Client["Client"]
        WebUI["Web UI"]
        MobileUI["Mobile UI"]
    end

    subgraph Edge["Edge"]
        Envoy["Envoy (edge proxy + API gateway)"]
        BFF["BFF (web, Node.js)"]
        Messenger["Messenger"]
        Notifier["Notifier"]
    end
        
    subgraph Core["Core"]
        SSO["SSO"]
        Redis("Redis")
        HistoricalAPI["Historical API"]
        RabbitMQ("RabbitMQ")
        HotStorage["Hot Storage"]
    end

    subgraph Storage["Storage"]
        PostgreSQL[("PostgreSQL")]
        MongoDB[("MongoDB")]
        BLOB[("BLOB Storage")]
    end

    %% ADR 0003 + 0005: Envoy is the single public entry point and the API gateway.
    %% It validates JWTs and per-route scopes on /api and /hubs; the BFF holds sessions.
    Client -->|HTTPS| Envoy
    Client <-->|WebSocket| Envoy
    Envoy -->|web: /, /bff, /signin-oidc| BFF
    Envoy -->|/connect, /account| SSO
    Envoy -->|/api: JWT + scope| HistoricalAPI
    Envoy <-->|/hubs: JWT| Messenger
    Envoy -.->|JWKS| SSO
    BFF -->|bearer, internal listener| Envoy
    BFF -.->|OIDC| SSO
    BFF -.->|sessions| Redis

    Messenger <-.-> RabbitMQ
    HistoricalAPI -->|Read| Redis
    HistoricalAPI -->|Read| Storage

    RabbitMQ -.-> HotStorage
    HotStorage -->|Persist| Storage

    classDef clientPkg fill:green,stroke:lightgreen,color:black
    classDef edgePkg fill:#f0fdf4,stroke:#4ade80,color:black
    classDef corePkg fill:#fef2f2,stroke:#f87171,color:black
    classDef service fill:#eef2ff,stroke:#818cf8,color:black
    classDef storage fill:#fff7ed,stroke:#fb923c,color:black
    classDef database fill:#f5f3ff,stroke:#a78bfa,color:black
    classDef infrastructure fill:#fefce8,stroke:#facc15,color:black

    class Client clientPkg
    class Edge edgePkg
    class Core corePkg
    class Envoy,BFF,Messenger,Notifier,SSO,HistoricalAPI,HotStorage service
    class Redis,RabbitMQ infrastructure
    class PostgreSQL,MongoDB,BLOB database