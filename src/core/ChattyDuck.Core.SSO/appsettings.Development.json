{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Duende": "Debug",
        "Microsoft": "Debug",
        "System": "Debug"
      }
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ChattyDuck_Identity;Username=postgres;Password=postgres"
  },

  "IdentityServer": {
    "Administrators": [
      {
        "UserName": "DevelopmentAdministrator",
        "Email": "chatty@duck.com",
        "FirstName": "Chatty",
        "LastName": "Duck",
        "Password": "ChattyDuck#2026"
      }
    ],
    "Scopes": [
      {
        "Name": "chatty:read",
        "DisplayName": "Chatty Read Scope",
        "Description": "Allows reading Chatty messages",
        "Required": true
      }
    ],
    "Clients": [
      {
        "ClientId": "chatty-web-client",
        "Enabled": true,
        "ClientName": "Chatty Web Client",
        "Description": "Web Chatty User UI",
        "AllowedGrantTypes": [
          "authorization_code"
        ],
        "RedirectUris": [
          "https://localhost:5002/signin-oidc"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:5002/signout-callback-oidc"
        ],
        "AllowedScopes": [
          "openid",
          "profile",
          "chatty:read"
        ],
        "RequirePkce": true,
        "RequireClientSecret": true,
        "ClientSecrets": [
          {
            "Description": "Local development only. Override with user-secrets or environment variables; never reuse outside localhost.",
            "Value": "chatty-web-client-local-dev-secret"
          }
        ],
        "AllowOfflineAccess": true,
        "AccessTokenLifetime": 900,
        "RefreshTokenUsage": "OneTimeOnly",
        "RefreshTokenExpiration": "Sliding",
        "SlidingRefreshTokenLifetime": 86400,
        "AbsoluteRefreshTokenLifetime": 2592000
      }
    ],
    "ApiResources": [
      {
        "Name": "chatty-api",
        "DisplayName": "ChattyDuck API",
        "Description": "The ChattyDuck Edge APIs (Messenger, API gateway). Its name is the 'aud' claim in access tokens.",
        "Scopes": [
          "chatty:read"
        ]
      }
    ],
    "IdentityResources": [
      {
        "Name": "openid",
        "DisplayName": "Your user identifier",
        "Required": true,
        "UserClaims": [
          "sub"
        ]
      },
      {
        "Name": "profile",
        "DisplayName": "User profile",
        "Description": "Your user profile information (first name, last name, etc.)",
        "Emphasize": true,
        "UserClaims": [
          "name",
          "family_name",
          "given_name",
          "middle_name",
          "nickname",
          "preferred_username",
          "profile",
          "picture",
          "website",
          "gender",
          "birthdate",
          "zoneinfo",
          "locale",
          "updated_at"
        ]
      },
      {
        "Name": "email",
        "DisplayName": "Your email address",
        "Emphasize": true,
        "UserClaims": [
          "email",
          "email_verified"
        ]
      }
    ]
  }
}